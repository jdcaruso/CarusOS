# Personal customizations - never commit (secrets, local config overrides).
# Anything dropped in customizations/ is ignored by default except *.example
# templates, which stay tracked as the public reference.
**/customizations/*
!**/customizations/*.example

# Arduino / PlatformIO build artifacts
build/
*.bin
*.elf
*.map
*.hex
*.o
*.a
.pio/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
